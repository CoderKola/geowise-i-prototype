# Monorepo: apps/mobile (Expo), apps/server (Node ingest), apps/web (Vite dashboard)

# dependencies (any app)
node_modules/
**/node_modules/

# Expo (apps/mobile)
.expo/
**/.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# generated native folders
apps/mobile/ios
apps/mobile/android

# Native signing
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ingest server (apps/server) — local secrets + data
apps/server/.env
apps/server/*.db
apps/server/*.db-*

# web dashboard (apps/web) build output
apps/web/dist/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# env / ts / os
.env*.local
*.tsbuildinfo
.DS_Store
*.pem
