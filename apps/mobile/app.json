{
  "expo": {
    "name": "geowise-i-prototype",
    "slug": "geowise-i-prototype",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.geowise.prototype",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "geowise logs your location to record your trips.",
          "locationAlwaysAndWhenInUsePermission": "geowise records your trips, including while the app is in the background or the screen is off.",
          "locationAlwaysPermission": "geowise records your trips, including while the app is in the background or the screen is off.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-background-task",
      "./plugins/withRawPropsJsiValue.js",
      "./plugins/withCameraForegroundService.js"
    ],
    "extra": {
      "eas": {
        "projectId": "0f65679f-ad7c-4b4e-9150-de48ceec5c92"
      }
    },
    "owner": "pathless-rehang1"
  }
}
